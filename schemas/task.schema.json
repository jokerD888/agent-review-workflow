{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jokerD888/agent-review-workflow/schemas/task.schema.json",
  "title": "ARW Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "kind", "branch", "base", "lifecycle", "review", "dependencies", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["feature", "bugfix", "maintenance", "refactor", "spike", "other"] },
    "branch": { "type": "string", "pattern": "^arw/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "parent_task": { "type": ["string", "null"] },
    "lifecycle": { "type": "string", "enum": ["active", "ready_for_review", "in_review", "approved", "parked", "merged", "abandoned"] },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_base_sha", "reviewed_head_sha"],
      "properties": {
        "status": { "type": "string", "enum": ["none", "changes_requested", "conditional", "approved", "stale"] },
        "reviewed_base_sha": { "type": "string", "pattern": "^(|[0-9a-f]{40})$" },
        "reviewed_head_sha": { "type": "string", "pattern": "^(|[0-9a-f]{40})$" }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
