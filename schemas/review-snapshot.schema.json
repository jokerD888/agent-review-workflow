{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jokerD888/agent-review-workflow/schemas/review-snapshot.schema.json",
  "title": "ARW Review Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "created_at", "base", "head", "comparison", "files", "commits", "working_tree", "dependency_status", "review_status", "risks"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "base": { "$ref": "#/$defs/revision" },
    "head": { "$ref": "#/$defs/revision" },
    "comparison": { "type": "string" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "commits": { "type": "array", "items": { "$ref": "#/$defs/commit" } },
    "working_tree": { "type": "string", "enum": ["clean", "dirty", "unknown"] },
    "dependency_status": { "type": "string", "enum": ["clear", "awaiting_prerequisite_review", "parent_changed", "blocked"] },
    "review_status": { "type": "string", "enum": ["none", "changes_requested", "conditional", "approved", "stale"] },
    "risks": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "revision": { "type": "object", "additionalProperties": false, "required": ["sha"], "properties": { "ref": { "type": "string" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "status"], "properties": { "path": { "type": "string" }, "status": { "type": "string" }, "additions": { "type": "integer", "minimum": 0 }, "deletions": { "type": "integer", "minimum": 0 } } },
    "commit": { "type": "object", "additionalProperties": false, "required": ["sha", "subject"], "properties": { "sha": { "type": "string" }, "subject": { "type": "string" } } }
  }
}
